# Copy to .env.local and fill in. Never commit real values. Then run `npm run doctor` (read-only) to check each service.

# MongoDB Atlas connection string (server only)
MONGODB_URI=

# Flagsmith admin API (server only; never prefix with NEXT_PUBLIC_)
FLAGSMITH_ADMIN_API_KEY=
FLAGSMITH_ORG_ID=
FLAGSMITH_PROJECT_ID=
FLAGSMITH_ENVIRONMENT_ID=

# Flagsmith client-side environment key. This is the only Flagsmith key the browser may see.
NEXT_PUBLIC_FLAGSMITH_ENV_KEY=

# AI (server only): drafting, Ask, insight wording, comment themes, voice-note translation. One of:
#   GROQ_API_KEY  Groq (free tier, in use): main model openai/gpt-oss-120b, fallback openai/gpt-oss-20b. Free limits are
#                 per model (1,000 requests a day, 8,000 tokens a minute each), so a rate-limited call moves to the other.
#   LLM_API_KEY   Anthropic key for Claude (a key starting gsk_ is treated as a Groq key).
# LLM_PROVIDER=groq|anthropic picks one when both are set. Without any: AI drafting says it needs a key, Ask runs a
# scripted planner over real data, insights use code templates, swipers type the English of a voice note.
# `npm run doctor` checks the key and that both Groq models still exist. See src/shared/lib/ai/llm-env.ts.
GROQ_API_KEY=
LLM_PROVIDER=
LLM_API_KEY=

# Optional model for translating voice notes to English (server only). Unset: openai/gpt-oss-20b on Groq, LLM_MODEL on Claude.
# The call already runs at low effort with a small output cap; a smaller model makes it cheaper and faster.
# Voice notes are turned into text by the swiper's browser; without LLM_API_KEY the swiper types the English.
LLM_TRANSLATE_MODEL=

# Firebase Authentication (sign-up, sign-in, email verification).
# Client values are public web-app config. Admin values are server only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the service-account private key with literal \n for newlines, inside double quotes.
FIREBASE_ADMIN_PRIVATE_KEY=

# Assistant "Test decided" watcher (server only). The cron route returns 503 without CRON_SECRET.
CRON_SECRET=

# Optional: email for the Test decided alert and emailed exports (server only). Nothing is sent without a key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Public app URL used in email links
NEXT_PUBLIC_APP_URL=
# Public support address shown on /contact, the legal pages and the footer. Leave empty until a real inbox exists:
# the pages then say the contact address will be published before launch.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Swipe signing secret (server only, 16+ characters). Required in production: signs the served-card token that binds dwell time and card to each swipe.
SWIPE_SIGNING_SECRET=

# The 30-card quality check for new swipers (spec 04 §5.9). Off by default for now: swipers go straight to the feed and
# every signed-in swipe counts. Set to "on" to bring it back (built into the app: a GitHub repo variable, then redeploy).
NEXT_PUBLIC_QUALITY_CHECK=

# Commit sha reported as "version" by /api/health (optional). The deploy workflow bakes it in at build time;
# on Vercel VERCEL_GIT_COMMIT_SHA is used instead.
GIT_SHA=

# Flagsmith admin API overrides (server only). Defaults target the hosted Flagsmith API.
FLAGSMITH_API_URL=
FLAGSMITH_ADMIN_AUTH_SCHEME=
# Where SDK events ($flag_exposure, reward_claim, answer_positive) are posted. Default for Flagsmith Cloud
# (FLAGSMITH_API_URL unset or a *.flagsmith.com host): https://events.api.flagsmith.com (path /v1/events), the host
# Flagsmith's own SDKs use. Default for a self-hosted FLAGSMITH_API_URL: that same URL, i.e. the core API's
# /api/v1/events/ (Cloud's events host does not accept self-hosted environment keys). Set it to the same value as
# FLAGSMITH_API_URL to force the core route (only works when the environment's warehouse is the Flagsmith database).
# Timestamps are always integer milliseconds.
FLAGSMITH_EVENTS_URL=

# LLM overrides (server only). LLM_MODEL defaults to openai/gpt-oss-120b on Groq, claude-opus-5-5 on Claude.
# LLM_FALLBACK_MODEL (Groq only) defaults to openai/gpt-oss-20b; "none" turns the fallback off. If Groq retires a model,
# `npm run doctor` says so: set LLM_MODEL to a model from https://console.groq.com/docs/models marked Production.
# LLM_BASE_URL is an API base (Groq: https://api.groq.com/openai/v1, Claude: https://api.anthropic.com); empty = default.
LLM_MODEL=
LLM_FALLBACK_MODEL=
LLM_BASE_URL=

# Public URLs used in email links and share links
APP_URL=
NEXT_PUBLIC_SITE_URL=
# Sender for emailed exports (server only, needs RESEND_API_KEY)
EXPORT_FROM_EMAIL=
