# Site files are included inside nginx's http block, so this zone is declared at http level.
# 20 requests/s per client IP for /api/ (burst 40); 10 MB holds about 160k addresses.
limit_req_zone $binary_remote_addr zone=pitchswipe_api:10m rate=20r/s;

# http: only Let's Encrypt challenges; everything else moves to https.
server {
    listen 80;
    listen [::]:80;
    server_name noor-api.centralindia.cloudapp.azure.com 20.204.106.112;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://noor-api.centralindia.cloudapp.azure.com$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name noor-api.centralindia.cloudapp.azure.com;

    # Let's Encrypt (certbot certonly --webroot); renewed by certbot's timer, nginx reloaded by its deploy hook.
    ssl_certificate /etc/letsencrypt/live/noor-api.centralindia.cloudapp.azure.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/noor-api.centralindia.cloudapp.azure.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Voice notes and card images are posted as JSON/form bodies.
    client_max_body_size 12m;

    # Compress text responses the app did not already compress (text/html is always included).
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/manifest+json application/xml image/svg+xml;

    # Proxy headers, inherited by both locations below (neither sets its own proxy_set_header).
    # The client IP is what nginx saw on the socket. X-Forwarded-For is OVERWRITTEN, not appended, so a client
    # cannot plant a fake first hop; the app's rate limiter reads X-Real-IP, then the last X-Forwarded-For hop.
    # X-Vercel-Forwarded-For is cleared because only Vercel's edge may set it.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Vercel-Forwarded-For "";
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 120s;

    # API: a coarse per-IP flood guard in front of the app's own per-route limits.
    location /api/ {
        limit_req zone=pitchswipe_api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
    }
}
