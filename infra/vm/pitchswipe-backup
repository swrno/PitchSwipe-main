#!/usr/bin/env bash
# Nightly dump of the pitchswipe database (gzipped archive), keeping the last 7. Run by /etc/cron.d/pitchswipe-backup.
set -euo pipefail
. /root/.pitchswipe-mongo
out=/var/backups/pitchswipe/pitchswipe-$(date -u +%Y%m%dT%H%M%SZ).archive.gz
mongodump --quiet --host 127.0.0.1 --port 27017 --username admin --password "$MONGO_ADMIN_PASSWORD" --authenticationDatabase admin --db pitchswipe --gzip --archive="$out"
chmod 600 "$out"
ls -1t /var/backups/pitchswipe/pitchswipe-*.archive.gz | tail -n +8 | xargs -r rm -f
