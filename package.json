{
  "name": "pitchswipe",
  "version": "0.1.0",
  "private": true,
  "description": "A/B test your pitch before you build your landing page.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:flagsmith": "node --import ./scripts/register-ts.mjs --test scripts/tests/flagsmith.test.mjs",
    "test:seed": "node --import ./scripts/register-ts.mjs --test scripts/seed/seed.test.mjs",
    "test:mongo": "node --import ./scripts/register-ts.mjs --test scripts/tests/mongo-stores.integration.mjs",
    "doctor": "node --import ./scripts/register-ts.mjs scripts/doctor.mjs",
    "seed": "node scripts/seed/seed.mjs",
    "seed:feed": "node --import ./scripts/register-ts.mjs scripts/seed/feed-decks.mjs",
    "db:sync-indexes": "node --import ./scripts/register-ts.mjs scripts/db/sync-indexes.mjs",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "cap:doctor": "cap doctor"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "13.3.0",
    "firebase-admin": "14.5.1",
    "framer-motion": "14.14.0",
    "lucide-react": "1.73.0",
    "mongoose": "9.12.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.15.3",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
